# Python byte-code and caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
venv/
.venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Sensitive credentials & environment files
.env
.env.*
.streamlit/secrets.toml
data/settings.json
data/user_feedback.json
scratch/

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Log & temporary files
*.log
*.lnk
*.db-journal

# Heavy raw textbook PDFs (already pre-indexed in data/vector_store)
materials/**/*.pdf
materials/*.pdf
!materials/.gitkeep
